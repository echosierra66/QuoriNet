import pygame
import sys
import threading
from collections import deque
from functools import lru_cache


# ==========================================
# 🤖 3-PLY QUORIDOR BOT
# ==========================================

def get_bot_move(game_state, player_id, debug=None):
    """
    3-ply minimax Quoridor bot.

    Evaluation:
        opponent shortest path - own shortest path

    Wall search is restricted to positions within
    4 blocks of either player or an existing wall.
    """

    if player_id != 2:
        return None

    def note(message):
        if debug is not None:
            debug['phase'] = message

    def note_check(message):
        if debug is not None:
            debug['checking'] = message

    def note_path(message):
        if debug is not None:
            debug['path'] = message

    def opponent(pid):
        return 1 if pid == 2 else 2

    def get_pos(state, pid):
        return state['p1_pos'] if pid == 1 else state['p2_pos']

    def set_pos(state, pid, pos):
        if pid == 1:
            state['p1_pos'] = pos
        else:
            state['p2_pos'] = pos

    def get_walls(state, pid):
        return state['p1_walls'] if pid == 1 else state['p2_walls']

    def remove_wall(state, pid):
        if pid == 1:
            state['p1_walls'] -= 1
        else:
            state['p2_walls'] -= 1

    BOARD_CELLS = 8
    NO_PATH = 99999

    def wall_bit(c, r):
        return 1 << (r * BOARD_CELLS + c)

    def mask_from_walls(walls):
        mask = 0
        for c, r in walls:
            mask |= wall_bit(c, r)
        return mask

    def iter_bits(mask):
        while mask:
            lsb = mask & -mask
            idx = lsb.bit_length() - 1
            yield idx % BOARD_CELLS, idx // BOARD_CELLS
            mask ^= lsb

    def wall_contact_count(state, c, r, orientation):
        """Only structural walls that make 2+ contacts need path validation."""
        contacts = set()

        def add_contact(nc, nr):
            if nc < 0 or nr < 0 or nc > 8 or nr > 8:
                contacts.add(('edge', nc, nr))
                return
            if (nc, nr) in state['walls_h'] or (nc, nr) in state['walls_v']:
                contacts.add(('wall', nc, nr))

        if orientation == 'H':
            add_contact(c - 1, r)
            add_contact(c + 1, r)
            add_contact(c, r - 1)
            add_contact(c, r + 1)

        else:
            add_contact(c - 1, r)
            add_contact(c + 1, r)
            add_contact(c, r - 1)
            add_contact(c, r + 1)

        return len(contacts)

    # --------------------------------------------------
    # Movement
    # --------------------------------------------------

    def adjacent(state, c, r):
        moves = []

        if (
            r > 0
            and (c, r - 1) not in state['walls_h']
            and (c - 1, r - 1) not in state['walls_h']
        ):
            moves.append((c, r - 1))

        if (
            r < 8
            and (c, r) not in state['walls_h']
            and (c - 1, r) not in state['walls_h']
        ):
            moves.append((c, r + 1))

        if (
            c > 0
            and (c - 1, r) not in state['walls_v']
            and (c - 1, r - 1) not in state['walls_v']
        ):
            moves.append((c - 1, r))

        if (
            c < 8
            and (c, r) not in state['walls_v']
            and (c, r - 1) not in state['walls_v']
        ):
            moves.append((c + 1, r))

        return moves

    def valid_moves(state, pid):
        pos = get_pos(state, pid)
        other = get_pos(state, opponent(pid))

        moves = adjacent(state, *pos)

        if other in moves:
            moves.remove(other)

            dc = other[0] - pos[0]
            dr = other[1] - pos[1]

            jump = (
                other[0] + dc,
                other[1] + dr
            )

            # Straight jump.
            if (
                0 <= jump[0] <= 8
                and 0 <= jump[1] <= 8
                and jump in adjacent(state, *other)
            ):
                moves.append(jump)

            # Diagonal jumps when straight jump is blocked.
            else:
                if dr != 0:
                    for side in [
                        (other[0] - 1, other[1]),
                        (other[0] + 1, other[1])
                    ]:
                        if (
                            0 <= side[0] <= 8
                            and 0 <= side[1] <= 8
                            and side in adjacent(state, *other)
                        ):
                            moves.append(side)

                if dc != 0:
                    for side in [
                        (other[0], other[1] - 1),
                        (other[0], other[1] + 1)
                    ]:
                        if (
                            0 <= side[0] <= 8
                            and 0 <= side[1] <= 8
                            and side in adjacent(state, *other)
                        ):
                            moves.append(side)

        return moves

    # --------------------------------------------------
    # 3x3 zone divide-and-conquer path search
    # --------------------------------------------------

    def board_zone(pos):
        c, r = pos
        return (r // 3, c // 3)

    def target_goal_zones(target_row):
        start_r = max(0, target_row - 2)
        end_r = min(8, target_row + 2)
        zones = set()

        for r in range(start_r, end_r + 1):
            for c in range(9):
                zones.add((r // 3, c // 3))

        return zones

    def wall_h_exists(mask, c, r):
        if not (0 <= c <= 8 and 0 <= r <= 8):
            return False
        return bool((mask >> (r * BOARD_CELLS + c)) & 1)

    def wall_v_exists(mask, c, r):
        if not (0 <= c <= 8 and 0 <= r <= 8):
            return False
        return bool((mask >> (r * BOARD_CELLS + c)) & 1)

    def adjacent_from_masks(c, r, walls_h_mask, walls_v_mask):
        moves = []

        if (
            r > 0
            and not wall_h_exists(walls_h_mask, c, r - 1)
            and not wall_h_exists(walls_h_mask, c - 1, r - 1)
        ):
            moves.append((c, r - 1))

        if (
            r < 8
            and not wall_h_exists(walls_h_mask, c, r)
            and not wall_h_exists(walls_h_mask, c - 1, r)
        ):
            moves.append((c, r + 1))

        if (
            c > 0
            and not wall_v_exists(walls_v_mask, c - 1, r)
            and not wall_v_exists(walls_v_mask, c - 1, r - 1)
        ):
            moves.append((c - 1, r))

        if (
            c < 8
            and not wall_v_exists(walls_v_mask, c, r)
            and not wall_v_exists(walls_v_mask, c, r - 1)
        ):
            moves.append((c + 1, r))

        return moves

    @lru_cache(maxsize=None)
    def shortest_path_cached(start, target_row, walls_h_mask, walls_v_mask):
        queue = deque([(start, 0)])
        visited = {start}
        goal_zones = target_goal_zones(target_row)

        while queue:
            pos, distance = queue.popleft()
            zone = board_zone(pos)

            if pos[1] == target_row or zone in goal_zones:
                return distance

            c, r = pos
            for nxt in adjacent_from_masks(c, r, walls_h_mask, walls_v_mask):
                if nxt not in visited:
                    visited.add(nxt)
                    queue.append((nxt, distance + 1))

        return NO_PATH

    def shortest_path(state, start, target_row):
        return shortest_path_cached(
            start,
            target_row,
            mask_from_walls(state['walls_h']),
            mask_from_walls(state['walls_v'])
        )

    def route_to_target(state, start, target_row):
        queue = deque([(start, [start])])
        visited = {start}

        while queue:
            pos, path = queue.popleft()

            if pos[1] == target_row:
                return path

            for nxt in adjacent(state, *pos):
                if nxt not in visited:
                    visited.add(nxt)
                    queue.append((nxt, path + [nxt]))

        return [start]

    # --------------------------------------------------
    # Wall validation
    # --------------------------------------------------

    def wall_valid(state, c, r, orientation):
        if not (0 <= c <= 7 and 0 <= r <= 7):
            return False

        if orientation == 'H':
            if (
                (c, r) in state['walls_h']
                or (c - 1, r) in state['walls_h']
                or (c + 1, r) in state['walls_h']
            ):
                return False

            if (c, r) in state['walls_v']:
                return False

            if wall_contact_count(state, c, r, orientation) <= 1:
                return True

            state['walls_h'].add((c, r))

        else:
            if (
                (c, r) in state['walls_v']
                or (c, r - 1) in state['walls_v']
                or (c, r + 1) in state['walls_v']
            ):
                return False

            if (c, r) in state['walls_h']:
                return False

            if wall_contact_count(state, c, r, orientation) <= 1:
                return True

            state['walls_v'].add((c, r))

        p1_path = shortest_path(
            state,
            state['p1_pos'],
            0
        )

        p2_path = shortest_path(
            state,
            state['p2_pos'],
            8
        )

        if orientation == 'H':
            state['walls_h'].remove((c, r))
        else:
            state['walls_v'].remove((c, r))

        return p1_path < NO_PATH and p2_path < NO_PATH

    # --------------------------------------------------
    # Copy state
    # --------------------------------------------------

    def copy_state(state):
        return {
            'p1_pos': state['p1_pos'],
            'p2_pos': state['p2_pos'],
            'p1_walls': state['p1_walls'],
            'p2_walls': state['p2_walls'],
            'walls_h': state['walls_h'].copy(),
            'walls_v': state['walls_v'].copy(),
            'turn': state['turn']
        }

    # --------------------------------------------------
    # Apply action
    # --------------------------------------------------

    def apply_action(state, pid, action):
        new_state = copy_state(state)

        action_type, data = action

        if action_type == 'move':
            set_pos(new_state, pid, data)

        elif action_type == 'wall':
            c, r, orient = data

            if orient == 'H':
                new_state['walls_h'].add((c, r))
            else:
                new_state['walls_v'].add((c, r))

            remove_wall(new_state, pid)

        new_state['turn'] = opponent(pid)

        return new_state

    # --------------------------------------------------
    # Wall candidate generation
    # --------------------------------------------------

    def generate_actions(state, pid):
        actions = []

        # Always consider movement.
        for move in valid_moves(state, pid):
            actions.append(('move', move))

        if get_walls(state, pid) <= 0:
            return actions

        my_pos = get_pos(state, pid)
        enemy_pos = get_pos(state, opponent(pid))

        my_target = 8 if pid == 2 else 0
        enemy_target = 8 if pid == 1 else 0

        my_path = shortest_path(
            state,
            my_pos,
            my_target
        )

        enemy_path = shortest_path(
            state,
            enemy_pos,
            enemy_target
        )

        if debug is not None:
            debug['path'] = f"mine={my_path} enemy={enemy_path}"

        if my_path >= NO_PATH or enemy_path >= NO_PATH:
            return actions

        def route_cells(start, target_row, max_radius=8):
            queue = deque([(start, 0)])
            visited = {start}
            cells = set()

            while queue:
                pos, distance = queue.popleft()
                cells.add(pos)

                if distance >= max_radius:
                    continue

                if pos[1] == target_row:
                    break

                for nxt in adjacent(state, *pos):
                    if nxt not in visited:
                        visited.add(nxt)
                        queue.append((nxt, distance + 1))

            return cells

        # --------------------------------------------------
        # Find every board coordinate within 4 blocks of:
        #
        # 1. Either player
        # 2. Every existing horizontal wall
        # 3. Every existing vertical wall
        # --------------------------------------------------

        corridor_limit = 6
        my_route = route_cells(my_pos, my_target, max_radius=min(corridor_limit, max(1, my_path)))
        enemy_route = route_cells(enemy_pos, enemy_target, max_radius=min(corridor_limit, max(1, enemy_path)))

        relevant = set()

        if my_path <= corridor_limit or enemy_path <= corridor_limit:
            important_points = list(my_route | enemy_route)
        else:
            my_route = []
            enemy_route = []

            my_queue = deque([(my_pos, 0)])
            enemy_queue = deque([(enemy_pos, 0)])
            my_seen = {my_pos}
            enemy_seen = {enemy_pos}

            while my_queue:
                pos, d = my_queue.popleft()
                my_route.append(pos)
                if d >= min(3, max(0, my_path - 1)):
                    break
                for nxt in adjacent(state, *pos):
                    if nxt not in my_seen:
                        my_seen.add(nxt)
                        my_queue.append((nxt, d + 1))

            while enemy_queue:
                pos, d = enemy_queue.popleft()
                enemy_route.append(pos)
                if d >= min(3, max(0, enemy_path - 1)):
                    break
                for nxt in adjacent(state, *pos):
                    if nxt not in enemy_seen:
                        enemy_seen.add(nxt)
                        enemy_queue.append((nxt, d + 1))

            important_points = [
                my_pos,
                enemy_pos,
                *my_route,
                *enemy_route
            ]

        important_points.extend(state['walls_h'])
        important_points.extend(state['walls_v'])

        for px, py in important_points:
            for dx in range(-4, 5):
                for dy in range(-4, 5):
                    c = px + dx
                    r = py + dy
                    if 0 <= c <= 7 and 0 <= r <= 7:
                        relevant.add((c, r))

        if my_path <= corridor_limit or enemy_path <= corridor_limit:
            relevant |= my_route
            relevant |= enemy_route
            narrowed = set()
            for c, r in relevant:
                for dx in range(-2, 3):
                    for dy in range(-2, 3):
                        cc = c + dx
                        rr = r + dy
                        if 0 <= cc <= 7 and 0 <= rr <= 7:
                            narrowed.add((cc, rr))
            relevant = narrowed

        wall_mask = mask_from_walls(state['walls_h']) | mask_from_walls(state['walls_v'])
        for c, r in iter_bits(wall_mask):
            for dx in range(-4, 5):
                for dy in range(-4, 5):
                    cc = c + dx
                    rr = r + dy
                    if 0 <= cc <= 7 and 0 <= rr <= 7:
                        relevant.add((cc, rr))

        candidate_mask = 0
        for c, r in relevant:
            candidate_mask |= (1 << (r * 8 + c))

        relevant = set()
        for idx in range(64):
            if (candidate_mask >> idx) & 1:
                relevant.add((idx % 8, idx // 8))

        candidates = []

        # --------------------------------------------------
        # Evaluate each nearby wall.
        # --------------------------------------------------

        for c, r in relevant:
            for orient in ('H', 'V'):

                if debug is not None:
                    debug['candidate_walls'] = [(c, r, orient)]
                    debug['checking'] = f"checking wall {orient} at {(c, r)}"

                if not wall_valid(
                    state,
                    c,
                    r,
                    orient
                ):
                    continue

                if orient == 'H':
                    state['walls_h'].add((c, r))
                else:
                    state['walls_v'].add((c, r))

                new_my_path = shortest_path(
                    state,
                    my_pos,
                    my_target
                )

                new_enemy_path = shortest_path(
                    state,
                    enemy_pos,
                    enemy_target
                )

                if orient == 'H':
                    state['walls_h'].remove((c, r))
                else:
                    state['walls_v'].remove((c, r))

                value = (
                    new_enemy_path - enemy_path
                ) - (
                    new_my_path - my_path
                )

                candidates.append(
                    (
                        value,
                        ('wall', (c, r, orient))
                    )
                )

        candidates.sort(
            key=lambda x: x[0],
            reverse=True
        )

        for _, action in candidates[:12]:
            actions.append(action)

        return actions

    # --------------------------------------------------
    # Evaluation
    # --------------------------------------------------

    def evaluate(state, bot_pid):
        enemy_pid = opponent(bot_pid)

        bot_pos = get_pos(state, bot_pid)
        enemy_pos = get_pos(state, enemy_pid)

        bot_target = 8 if bot_pid == 2 else 0
        enemy_target = 8 if enemy_pid == 2 else 0

        bot_distance = shortest_path(
            state,
            bot_pos,
            bot_target
        )

        enemy_distance = shortest_path(
            state,
            enemy_pos,
            enemy_target
        )

        score = enemy_distance - bot_distance

        if bot_distance >= NO_PATH:
            score -= 10000

        if enemy_distance >= NO_PATH:
            score += 10000

        # Winning / losing dominates normal evaluation.
        if bot_pos[1] == bot_target:
            score += 1000

        if enemy_pos[1] == enemy_target:
            score -= 1000

        return score

    def is_terminal_state(state, pid):
        pos = get_pos(state, pid)
        target = 8 if pid == 2 else 0
        return pos[1] == target

    # --------------------------------------------------
    # 3-ply minimax
    # --------------------------------------------------

    BOT = player_id

    def minimax(state, depth, maximizing):

        note(f"evaluating depth {depth} for {'bot' if maximizing else 'opponent'}")

        if is_terminal_state(state, BOT):
            return 100000

        if is_terminal_state(state, opponent(BOT)):
            return -100000

        bot_distance = shortest_path(
            state,
            get_pos(state, BOT),
            8 if BOT == 2 else 0
        )

        enemy_distance = shortest_path(
            state,
            get_pos(state, opponent(BOT)),
            8 if opponent(BOT) == 2 else 0
        )

        if bot_distance >= NO_PATH:
            return -100000

        if enemy_distance >= NO_PATH:
            return 100000

        if depth == 0:
            return evaluate(
                state,
                BOT
            )

        pid = (
            BOT
            if maximizing
            else opponent(BOT)
        )

        actions = generate_actions(
            state,
            pid
        )

        if not actions:
            return evaluate(
                state,
                BOT
            )

        if maximizing:
            best = -float('inf')

            for action in actions:

                new_state = apply_action(
                    state,
                    pid,
                    action
                )

                score = minimax(
                    new_state,
                    depth - 1,
                    False
                )

                best = max(
                    best,
                    score
                )

            return best

        else:
            best = float('inf')

            for action in actions:

                new_state = apply_action(
                    state,
                    pid,
                    action
                )

                score = minimax(
                    new_state,
                    depth - 1,
                    True
                )

                best = min(
                    best,
                    score
                )

            return best

    # --------------------------------------------------
    # Root search
    # --------------------------------------------------

    actions = generate_actions(
        game_state,
        BOT
    )

    if not actions:
        return None

    best_action = None
    best_score = -float('inf')

    for action in actions:

        note(f"testing root move {action}")

        new_state = apply_action(
            game_state,
            BOT,
            action
        )

        if is_terminal_state(new_state, BOT):
            if debug is not None:
                debug['selected_path'] = route_to_target(
                    new_state,
                    get_pos(new_state, BOT),
                    8 if BOT == 2 else 0
                )
            return action

        if debug is not None:
            debug['selected_path'] = route_to_target(
                new_state,
                get_pos(new_state, BOT),
                8 if BOT == 2 else 0
            )

        score = minimax(
            new_state,
            2,
            False
        )

        if score > best_score:
            best_score = score
            best_action = action

    return best_action


