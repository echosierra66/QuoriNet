def get_bot_move(game_state, player_id):
    """
    This function is called every time it is the bot's turn.
    
    :param game_state: A dictionary containing the current board state:
        {
            'p1_pos': (col, row), # Player 1 (Bottom, moves Up to row 0)
            'p2_pos': (col, row), # Player 2 (Top, moves Down to row 8)
            'p1_walls': int,      # Walls left for Player 1
            'p2_walls': int,      # Walls left for Player 2
            'walls_h': set(),     # Set of (col, row) for horizontal walls
            'walls_v': set(),     # Set of (col, row) for vertical walls
            'turn': int           # 1 or 2
        }
    :param player_id: 1 (Player 1) or 2 (Player 2)
    
    :return: 
        - Movement: ('move', (col, row))
        - Wall: ('wall', (col, row, 'H' or 'V'))
        - None: If you want a human to play this turn with the mouse.
    """
    
    # Example to make Player 2 a bot:
    # if player_id == 2:
    #     return ('move', (game_state['p2_pos'][0], game_state['p2_pos'][1] + 1)) # Dumb bot moving down
    
    return None # Leaving this as None allows humans to play via mouse

# ==========================================
# 🎮 GAME ENGINE & UI (Do not change unless customizing the UI)
# ==========================================

# Settings
CELL_SIZE = 60
WALL_THICKNESS = 15
BOARD_SIZE = 9
WIDTH = BOARD_SIZE * CELL_SIZE + (BOARD_SIZE - 1) * WALL_THICKNESS + 40
HEIGHT = WIDTH + 80 # Extra space for UI

# Colors
BG_COLOR = (20, 20, 20)
CELL_COLOR = (139, 69, 19)
WALL_COLOR = (200, 150, 50)
WALL_HOVER_COLOR = (150, 100, 30, 150)
P1_COLOR = (50, 150, 255)
P2_COLOR = (255, 50, 50)
VALID_MOVE_COLOR = (50, 200, 50)
TEXT_COLOR = (255, 255, 255)

class Quoridor:
    def __init__(self):
        pygame.init()
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT))
        pygame.display.set_caption("Quoridor Bot Environment")
        self.font = pygame.font.SysFont("Arial", 24)
        
        # Game State
        self.p1_pos = (4, 8)
        self.p2_pos = (4, 0)
        self.p1_walls = 10
        self.p2_walls = 10
        self.walls_h = set() # Stores top-left cell coordinate (c, r)
        self.walls_v = set() # Stores top-left cell coordinate (c, r)
        self.turn = 1
        self.move_history = []
        
        # UI State
        self.wall_orientation = 'H' # 'H' or 'V' (Toggle with Right Click)

    def coord_to_standard_notation(self, pos):
        c, r = pos
        col = chr(ord('a') + c)
        row = 9 - r
        return f"{col}{row}"

    def record_move(self, player_id, action, data):
        if action == 'move':
            notation = f"P{player_id}: {self.coord_to_standard_notation(data)}"
        elif action == 'wall':
            c, r, orient = data
            notation = f"P{player_id}: {orient} {self.coord_to_standard_notation((c, r))}"
        else:
            notation = f"P{player_id}: {action}"

        self.move_history.append(notation)
        print(f"Move recorded: {notation}")
        print(f"Previous moves: {self.move_history}")
        
    def get_state(self):
        return {
            'p1_pos': self.p1_pos,
            'p2_pos': self.p2_pos,
            'p1_walls': self.p1_walls,
            'p2_walls': self.p2_walls,
            'walls_h': self.walls_h.copy(),
            'walls_v': self.walls_v.copy(),
            'turn': self.turn
        }

    def get_valid_moves(self, pos):
        c, r = pos
        moves = []
        # Up
        if r > 0 and (c, r-1) not in self.walls_h and (c-1, r-1) not in self.walls_h: moves.append((c, r-1))
        # Down
        if r < 8 and (c, r) not in self.walls_h and (c-1, r) not in self.walls_h: moves.append((c, r+1))
        # Left
        if c > 0 and (c-1, r) not in self.walls_v and (c-1, r-1) not in self.walls_v: moves.append((c-1, r))
        # Right
        if c < 8 and (c, r) not in self.walls_v and (c, r-1) not in self.walls_v: moves.append((c+1, r))
        
        # Filter out jumping for simplicity in this template (players can't occupy same space)
        other_pos = self.p2_pos if self.turn == 1 else self.p1_pos
        if other_pos in moves:
            moves.remove(other_pos)
            # Basic jump over logic (straight line only)
            dc, dr = other_pos[0] - c, other_pos[1] - r
            jump_pos = (other_pos[0] + dc, other_pos[1] + dr)
            if 0 <= jump_pos[0] <= 8 and 0 <= jump_pos[1] <= 8:
                # Need to check if wall blocks the jump too (omitted for template simplicity)
                moves.append(jump_pos)
                
        return moves

    def is_valid_wall(self, c, r, orientation):
        if c < 0 or c > 7 or r < 0 or r > 7: return False
        if orientation == 'H':
            if (c, r) in self.walls_h or (c-1, r) in self.walls_h or (c+1, r) in self.walls_h: return False
            if (c, r) in self.walls_v: return False # Cross intersection
        else:
            if (c, r) in self.walls_v or (c, r-1) in self.walls_v or (c, r+1) in self.walls_v: return False
            if (c, r) in self.walls_h: return False # Cross intersection
        # Note: A full pathfinding BFS check to ensure players aren't trapped should be added here for a strict rule engine.
        return True

    def draw_board(self, mouse_pos):
        self.screen.fill(BG_COLOR)
        offset_x, offset_y = 20, 60
        
        # Draw UI
        p1_text = self.font.render(f"P1 (Blue) Walls: {self.p1_walls}", True, P1_COLOR)
        p2_text = self.font.render(f"P2 (Red) Walls: {self.p2_walls}", True, P2_COLOR)
        turn_text = self.font.render(f"Turn: Player {self.turn}", True, TEXT_COLOR)
        self.screen.blit(p1_text, (20, HEIGHT - 35))
        self.screen.blit(p2_text, (WIDTH - 180, 20))
        self.screen.blit(turn_text, (20, 20))

        # Draw Cells & Valid Moves
        valid_moves = self.get_valid_moves(self.p1_pos if self.turn == 1 else self.p2_pos)
        for r in range(BOARD_SIZE):
            for c in range(BOARD_SIZE):
                x = offset_x + c * (CELL_SIZE + WALL_THICKNESS)
                y = offset_y + r * (CELL_SIZE + WALL_THICKNESS)
                pygame.draw.rect(self.screen, CELL_COLOR, (x, y, CELL_SIZE, CELL_SIZE), border_radius=5)
                
                if (c, r) in valid_moves:
                    pygame.draw.circle(self.screen, VALID_MOVE_COLOR, (x + CELL_SIZE//2, y + CELL_SIZE//2), 10)

        # Draw Placed Walls
        for (c, r) in self.walls_h:
            x = offset_x + c * (CELL_SIZE + WALL_THICKNESS)
            y = offset_y + r * (CELL_SIZE + WALL_THICKNESS) + CELL_SIZE
            pygame.draw.rect(self.screen, WALL_COLOR, (x, y, CELL_SIZE * 2 + WALL_THICKNESS, WALL_THICKNESS))
        
        for (c, r) in self.walls_v:
            x = offset_x + c * (CELL_SIZE + WALL_THICKNESS) + CELL_SIZE
            y = offset_y + r * (CELL_SIZE + WALL_THICKNESS)
            pygame.draw.rect(self.screen, WALL_COLOR, (x, y, WALL_THICKNESS, CELL_SIZE * 2 + WALL_THICKNESS))

        # Draw Wall Hover (Ghost Wall)
        mx, my = mouse_pos
        c_hover = (mx - offset_x) // (CELL_SIZE + WALL_THICKNESS)
        r_hover = (my - offset_y) // (CELL_SIZE + WALL_THICKNESS)
        
        if 0 <= c_hover < 8 and 0 <= r_hover < 8:
            hx = offset_x + c_hover * (CELL_SIZE + WALL_THICKNESS)
            hy = offset_y + r_hover * (CELL_SIZE + WALL_THICKNESS)
            
            surface = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            if self.wall_orientation == 'H' and self.is_valid_wall(c_hover, r_hover, 'H'):
                pygame.draw.rect(surface, WALL_HOVER_COLOR, (hx, hy + CELL_SIZE, CELL_SIZE * 2 + WALL_THICKNESS, WALL_THICKNESS))
            elif self.wall_orientation == 'V' and self.is_valid_wall(c_hover, r_hover, 'V'):
                pygame.draw.rect(surface, WALL_HOVER_COLOR, (hx + CELL_SIZE, hy, WALL_THICKNESS, CELL_SIZE * 2 + WALL_THICKNESS))
            self.screen.blit(surface, (0, 0))

        # Draw Players
        p1_x = offset_x + self.p1_pos[0] * (CELL_SIZE + WALL_THICKNESS) + CELL_SIZE//2
        p1_y = offset_y + self.p1_pos[1] * (CELL_SIZE + WALL_THICKNESS) + CELL_SIZE//2
        pygame.draw.circle(self.screen, P1_COLOR, (p1_x, p1_y), CELL_SIZE//2 - 5)

        p2_x = offset_x + self.p2_pos[0] * (CELL_SIZE + WALL_THICKNESS) + CELL_SIZE//2
        p2_y = offset_y + self.p2_pos[1] * (CELL_SIZE + WALL_THICKNESS) + CELL_SIZE//2
        pygame.draw.circle(self.screen, P2_COLOR, (p2_x, p2_y), CELL_SIZE//2 - 5)

        pygame.display.flip()

    def play(self):
        clock = pygame.time.Clock()
        running = True
        
        while running:
            mouse_pos = pygame.mouse.get_pos()
            
            # --- BOT LOGIC HOOK ---
            bot_move = get_bot_move(self.get_state(), self.turn)
            if bot_move:
                action, data = bot_move
                if action == 'move' and data in self.get_valid_moves(self.p1_pos if self.turn == 1 else self.p2_pos):
                    if self.turn == 1: self.p1_pos = data
                    else: self.p2_pos = data
                    self.record_move(self.turn, 'move', data)
                    self.turn = 2 if self.turn == 1 else 1
                elif action == 'wall':
                    c, r, orient = data
                    if self.is_valid_wall(c, r, orient):
                        if orient == 'H': self.walls_h.add((c, r))
                        else: self.walls_v.add((c, r))
                        if self.turn == 1: self.p1_walls -= 1
                        else: self.p2_walls -= 1
                        self.record_move(self.turn, 'wall', data)
                        self.turn = 2 if self.turn == 1 else 1
                # Small delay so humans can see bot moves
                pygame.time.delay(300)
            
            # --- HUMAN LOGIC HOOK ---
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                
                # Only allow mouse input if bot didn't make a move
                if bot_move is None and event.type == pygame.MOUSEBUTTONDOWN:
                    if event.button == 3: # Right Click: Toggle Wall Orientation
                        self.wall_orientation = 'V' if self.wall_orientation == 'H' else 'H'
                    
                    if event.button == 1: # Left Click: Move or Place Wall
                        mx, my = mouse_pos
                        offset_x, offset_y = 20, 60
                        c = (mx - offset_x) // (CELL_SIZE + WALL_THICKNESS)
                        r = (my - offset_y) // (CELL_SIZE + WALL_THICKNESS)
                        
                        # Handle Movement
                        valid_moves = self.get_valid_moves(self.p1_pos if self.turn == 1 else self.p2_pos)
                        if (c, r) in valid_moves:
                            if self.turn == 1: self.p1_pos = (c, r)
                            else: self.p2_pos = (c, r)
                            self.record_move(self.turn, 'move', (c, r))
                            self.turn = 2 if self.turn == 1 else 1
                            
                        # Handle Wall Placement
                        elif 0 <= c < 8 and 0 <= r < 8:
                            if (self.turn == 1 and self.p1_walls > 0) or (self.turn == 2 and self.p2_walls > 0):
                                if self.is_valid_wall(c, r, self.wall_orientation):
                                    if self.wall_orientation == 'H': self.walls_h.add((c, r))
                                    else: self.walls_v.add((c, r))
                                    
                                    if self.turn == 1: self.p1_walls -= 1
                                    else: self.p2_walls -= 1
                                    self.record_move(self.turn, 'wall', (c, r, self.wall_orientation))
                                    self.turn = 2 if self.turn == 1 else 1
                                    
            self.draw_board(mouse_pos)
            clock.tick(30)
            
        pygame.quit()
        sys.exit()

if __name__ == "__main__":
    game = Quoridor()
    game.play()